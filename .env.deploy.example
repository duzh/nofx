# Deploy target for scripts/deploy.sh
# Copy to .env.deploy (gitignored) and fill in — NEVER commit real values.

# Server address (IP or hostname)
DEPLOY_HOST=1.2.3.4
# SSH port (default 22)
DEPLOY_PORT=22
# SSH username
DEPLOY_USER=root
# SSH password (password auth via sshpass)
DEPLOY_PASS=your-password-here
# Absolute path on the server where the repo is deployed
DEPLOY_PATH=/opt/nofx
